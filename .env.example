# Copy this file to .env and fill in your key to enable bounded LLM RAG enhancements.
# Deprecated: the legacy free-form agent is no longer called by the API.
ENABLE_ANTHROPIC_AGENT=false

# LLM enhancements are enabled by default when the selected provider has an API key.
ENABLE_LLM_RAG_ENHANCEMENTS=true
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_INPUT_PRICE_PER_MTOK=1.0
LLM_OUTPUT_PRICE_PER_MTOK=5.0
LLM_CACHE_WRITE_PRICE_PER_MTOK=1.25
LLM_CACHE_READ_PRICE_PER_MTOK=0.10
RAG_RESEARCH_MAX_ROUNDS=3
RAG_RESEARCH_QUERIES_PER_ROUND=3
RAG_RESEARCH_MAX_CANDIDATES=8
ANTHROPIC_AGENT_MAX_TOKENS=4096
ANTHROPIC_API_KEY=your_key_here

# Per-chat JSON trajectories and incremental JSONL events (default: data/trajectories)
# TRAJECTORY_DIR=data/trajectories

# Select the provider for chat routing, itinerary writing and RAG.
# Existing installations default to anthropic when LLM_PROVIDER is omitted.
LLM_PROVIDER=anthropic
OPENAI_API_KEY=your_key_here
# Required for OpenAI: use a Responses API model available to your account.
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0
# Set false to bypass environment/system proxies for outbound LLM calls.
LLM_TRUST_ENV=true
# Optional: model-specific OpenAI prices in USD per million tokens.
# Leave unset to report cost as null instead of applying Anthropic prices.
# OPENAI_INPUT_PRICE_PER_MTOK=
# OPENAI_OUTPUT_PRICE_PER_MTOK=
# OPENAI_CACHE_READ_PRICE_PER_MTOK=

# Cooperative whole-run admission limits (independent of per-call SDK timeout).
RUN_TIMEOUT_SECONDS=180
RUN_MAX_LLM_CALLS=12
RUN_MAX_TOOL_CALLS=40
RUN_MAX_OUTPUT_TOKENS=32000

# Optional model-directed place node, using a local stdio MCP server and real Geoapify.
# Leave disabled until GEOAPIFY_API_KEY is configured; no fabricated coordinate fallback.
ENABLE_PLACE_RESOLUTION=false
GEOAPIFY_API_KEY=
# Independent of LLM_TRUST_ENV. Explicit proxy works even when trust_env=false.
PLACES_TRUST_ENV=true
# PLACES_PROXY_URL=http://127.0.0.1:7890
# PLACES_CA_BUNDLE=/absolute/path/to/trusted-ca-bundle.pem
PLACE_MAX_ACTIVITIES=6
PLACE_MAX_ROUNDS=6
PLACE_MAX_TOOL_CALLS=12
