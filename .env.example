# Copy this file to .env and fill in your key to enable bounded LLM RAG enhancements.
# Deprecated: the legacy free-form agent is no longer called by the API.
ENABLE_ANTHROPIC_AGENT=false

# LLM enhancements are enabled by default when ANTHROPIC_API_KEY is present.
ENABLE_LLM_RAG_ENHANCEMENTS=true
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_INPUT_PRICE_PER_MTOK=1.0
LLM_OUTPUT_PRICE_PER_MTOK=5.0
LLM_CACHE_WRITE_PRICE_PER_MTOK=1.25
LLM_CACHE_READ_PRICE_PER_MTOK=0.10
RAG_RESEARCH_MAX_ROUNDS=3
RAG_RESEARCH_QUERIES_PER_ROUND=3
RAG_RESEARCH_MAX_CANDIDATES=8
ANTHROPIC_AGENT_MAX_TOKENS=4096
ANTHROPIC_API_KEY=your_key_here
